# Copy this file to .env and change values if needed.
PORT=3000
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=Fabulari_chat
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:4200
# Chatrooms with no messages for this many days are deleted automatically. 0 turns it off.
CHANNEL_INACTIVE_DAYS=30
# Create demo users and groups when the database is empty.
SEED_DEMO=true
